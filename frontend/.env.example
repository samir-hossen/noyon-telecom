# Copy this file to .env (for local dev) or configure these as build-time
# environment variables in your hosting provider (Vercel, Netlify, etc).
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Backend API base URL.
# - Local dev: leave unset — Vite proxies /api to http://localhost:4000 (see vite.config.js)
# - Production: point to your deployed backend, e.g. https://api.yourdomain.com/api
VITE_API_URL=

# The storefront's own real production URL (no trailing slash), e.g.
# https://www.yourdomain.com. Used to build canonical/og:url tags that stay
# pinned to one real domain no matter which host actually served the page —
# same reasoning as the backend's required SITE_URL (see
# backend/src/routes/sitemap.routes.js). Leave blank and it falls back to
# the browser's current origin (fine for local dev / before this is set).
VITE_SITE_URL=

# Google reCAPTCHA v3 site key, used on the Contact page to prevent spam
# submissions. Get one at https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=

# Google Analytics 4 measurement id (e.g. "G-XXXXXXX"). Leave blank to skip
# analytics entirely — see src/analytics.js.
VITE_GA_ID=

# Google Ads conversion id (e.g. "AW-XXXXXXXXX"), for conversion tracking on
# top of GA4 pageviews/events. Leave blank to skip.
VITE_GOOGLE_ADS_ID=
# Conversion label for the Purchase action, from Google Ads -> Goals ->
# Conversions -> your conversion action -> "See tag setup" -> the part after
# "AW-XXXXXXX/" in the send_to value. Both this and VITE_GOOGLE_ADS_ID are
# required for the conversion event to actually fire — see src/analytics.js.
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Meta (Facebook/Instagram) Pixel id. Leave blank to skip — see src/pixels.js.
VITE_META_PIXEL_ID=

# TikTok Pixel id. Leave blank to skip — see src/pixels.js.
VITE_TIKTOK_PIXEL_ID=

# Sentry DSN for production error tracking (sentry.io -> Project Settings ->
# Client Keys). Leave blank to skip — errors still log to console + GA4.
VITE_SENTRY_DSN=
