# Copy to .env and fill in real values before running.

# --- Database -----------------------------------------------------------
# Any managed Postgres works (Neon, Supabase, Railway, RDS, local Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/noyontelecom?schema=public"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:5173
# Public URL of the storefront (frontend), used to build absolute URLs in
# the dynamic sitemap and Google Merchant product feed. Set this to your
# real domain before going live — Google will reject a feed/sitemap full of
# "yourdomain.com" placeholder links.
SITE_URL=https://www.yourdomain.com

# --- Auth / sessions --------------------------------------------------------
# Long random strings in production — e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Name/issuer shown in the authenticator app when admins scan the 2FA QR code.
TOTP_ISSUER="Noyon Telecom"

# --- Email (used for verification, password reset, order & contact mail) ---
# Leave SMTP_HOST empty in local dev — emails are logged to the console
# instead of actually being sent, so you can copy links out of the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Noyon Telecom <no-reply@yourdomain.com>"
STORE_CONTACT_EMAIL=support@yourdomain.com

# Base URL of the deployed frontend, used to build links inside emails
# (verification, password reset).
FRONTEND_URL=http://localhost:5173

# --- reCAPTCHA v3 (optional) ------------------------------------------------
# Leave blank to skip verification entirely (useful for local dev).
RECAPTCHA_SECRET_KEY=

# --- Online payment (SSLCommerz — bKash / Nagad / Rocket / cards) -----------
# Free sandbox credentials: https://developer.sslcommerz.com/registration/
# Leave blank in local dev and the "Online payment" option will show a clear
# error instead of crashing; Cash on delivery still works without these.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
# Public URL of THIS backend (SSLCommerz redirects/IPN post back here).
# Use an https tunnel (ngrok, etc.) in local dev if you want to test the
# full redirect flow — SSLCommerz can't reach http://localhost.
API_URL=http://localhost:4000

# --- Seed script -------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@noyontelecom.com
SEED_ADMIN_PASSWORD=ChangeMe123
SEED_DEALER_EMAIL=dealer@noyontelecom.com
SEED_DEALER_PASSWORD=ChangeMe123

# --- SMS notifications (order placed / shipped / delivered) ----------------
# Wired for BulkSMSBD (bulksmsbd.net) — sign up, then find your API key and
# an approved sender ID on the dashboard. See src/utils/sms.js if you'd
# rather use a different BD gateway (Alpha SMS, SSL Wireless, Elitbuzz...);
# it's a single small file to swap. Leave both blank in local dev — SMS
# text just gets logged to the console instead of actually being sent.
SMS_API_KEY=
SMS_SENDER_ID=

# --- Meta Conversions API (server-side Purchase tracking) -------------------
# Recovers Purchase conversions the browser Meta Pixel misses (iOS 14.5+ ATT,
# ad blockers, Safari ITP) — see src/utils/metaCapi.js. Leave blank to skip;
# the browser Pixel (VITE_META_PIXEL_ID in frontend/.env) still works alone.
# Get the access token from Meta Events Manager -> your Pixel -> Settings ->
# Conversions API -> Generate access token.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: set while testing so events show under Events Manager's "Test
# events" tab instead of mixing into real ad-optimization data. Remove
# before going live.
META_CAPI_TEST_EVENT_CODE=

# --- Error tracking (Sentry — optional but recommended) --------------------
# Leave blank to skip; errors still get logged to console/stdout either way.
# With this set, backend crashes and request errors (errorHandler.js) also
# report to Sentry — same idea as VITE_SENTRY_DSN on the frontend, so both
# sides are covered instead of just the browser. Get a DSN from
# sentry.io -> Project Settings -> Client Keys, then `npm install @sentry/node`.
SENTRY_DSN=

# --- Product image storage (Cloudinary — optional but recommended) ----------
# Free account: https://cloudinary.com/users/register/free
# Find these on your Cloudinary Dashboard after signup.
# Leave all three blank to keep saving images to the local uploads/ folder
# (fine for local dev, but most hosting platforms wipe local disk on every
# redeploy — set these before going live so product photos don't disappear).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Search (Meilisearch — optional, worth it once search volume/catalog
# size make Postgres `contains` search feel limited) ------------------------
# Self-hosted, not a signup-required account like Cloudinary/SSLCommerz —
# you run the server yourself. Quickest way to try it locally:
#   docker run -p 7700:7700 getmeili/meilisearch:latest
# or download a binary directly: https://www.meilisearch.com/docs/learn/self_hosted/getting_started_with_self_hosted_meilisearch
# For production, a small VPS or a Railway/Fly.io deployment both work fine
# at this scale — see https://www.meilisearch.com/docs/learn/self_hosted/getting_started_with_self_hosted_meilisearch
# Leave MEILISEARCH_HOST blank to keep using Postgres trigram search (the
# default, and completely fine up to a few thousand SKUs) — see
# backend/src/utils/search.js for exactly what this changes and what stays
# the same either way.
MEILISEARCH_HOST=
# Meilisearch's "master key" (set via MEILI_MASTER_KEY when you start your
# instance) or a scoped API key generated from it — required once your
# instance isn't running in development mode. Leave blank for a local dev
# instance with no master key set.
MEILISEARCH_API_KEY=
# After first setting MEILISEARCH_HOST (or any time you rebuild the
# Meilisearch instance from scratch), run this once to push the existing
# catalog into it — an empty index has nothing to search until then:
#   npm run sync:search

